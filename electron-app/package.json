{
  "private": true,
  "name": "arduino-ai-ide",
  "version": "2.3.11",
  "license": "AGPL-3.0-or-later",
  "main": "./src-gen/backend/electron-main.js",
  "dependencies": {
    "@theia/core": "1.57.0",
    "@theia/debug": "1.57.0",
    "@theia/editor": "1.57.0",
    "@theia/electron": "1.57.0",
    "@theia/filesystem": "1.57.0",
    "@theia/keymaps": "1.57.0",
    "@theia/messages": "1.57.0",
    "@theia/monaco": "1.57.0",
    "@theia/navigator": "1.57.0",
    "@theia/plugin-ext": "1.57.0",
    "@theia/plugin-ext-vscode": "1.57.0",
    "@theia/preferences": "1.57.0",
    "@theia/terminal": "1.57.0",
    "@theia/workspace": "1.57.0",
    "arduino-ide-extension": "2.3.11"
  },
  "devDependencies": {
    "@theia/cli": "1.57.0",
    "electron": "30.1.2",
    "electron-builder": "^25.1.8"
  },
  "scripts": {
    "prepare": "theia download:plugins",
    "prebuild": "rimraf lib",
    "build": "theia build",
    "postbuild": "node -e \"const fs=require('fs-extra');const src='../arduino-ide-extension/lib/node/resources';const dst='lib/backend/resources';if(fs.existsSync(src)){fs.copySync(src,dst,{overwrite:true});console.log('Resources copied to '+dst);}\"",
    "prebuild:dev": "yarn prebuild",
    "build:dev": "theia build --config webpack.dev.js --mode development",
    "postbuild:dev": "yarn postbuild",
    "start": "theia start --plugins=local-dir:../plugins",
    "watch": "theia build --config webpack.dev.js --mode development --watch",
    "rebuild": "theia rebuild:browser --cacheRoot .. && theia rebuild:electron --cacheRoot ..",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "cc.arduino.arduino-ai-ide",
    "productName": "Arduino AI IDE",
    "copyright": "Copyright © 2024 Arduino SA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "lib/**/*",
      "src-gen/**/*",
      "plugins/**/*"
    ],
    "extraResources": [
      {
        "from": "lib/backend/resources",
        "to": "resources",
        "filter": ["**/*"]
      }
    ],
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "Development",
      "icon": "../arduino-ide-extension/src/browser/style/icons",
      "artifactName": "arduino-ai-ide-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "../arduino-ide-extension/src/browser/style/icons",
      "artifactName": "arduino-ai-ide-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "../arduino-ide-extension/src/browser/style/icons",
      "artifactName": "arduino-ai-ide-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "theiaPlugins": {
    "vscode-builtin-cpp": "https://open-vsx.org/api/vscode/cpp/1.88.1/file/vscode.cpp-1.88.1.vsix",
    "vscode-arduino-api": "https://github.com/dankeboy36/vscode-arduino-api/releases/download/0.1.2/vscode-arduino-api-0.1.2.vsix",
    "vscode-arduino-tools": "https://downloads.arduino.cc/vscode-arduino-tools/vscode-arduino-tools-0.1.3.vsix",
    "vscode-builtin-json": "https://open-vsx.org/api/vscode/json/1.88.1/file/vscode.json-1.88.1.vsix",
    "vscode-builtin-json-language-features": "https://open-vsx.org/api/vscode/json-language-features/1.88.1/file/vscode.json-language-features-1.88.1.vsix"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "Arduino AI IDE",
        "defaultTheme": {
          "light": "arduino-theme",
          "dark": "arduino-theme-dark"
        },
        "defaultIconTheme": "none",
        "validatePreferencesSchema": false,
        "electron": {
          "showWindowEarly": true,
          "uriScheme": "arduino-ide"
        },
        "reloadOnReconnect": true,
        "preferences": {
          "window.title": "${rootName}${activeEditorShort}${appName}",
          "files.autoSave": "afterDelay",
          "editor.minimap.enabled": false,
          "editor.tabSize": 2,
          "editor.scrollBeyondLastLine": false,
          "editor.quickSuggestions": {
            "other": false,
            "comments": false,
            "strings": false
          },
          "editor.maxTokenizationLineLength": 500,
          "editor.bracketPairColorization.enabled": false,
          "breadcrumbs.enabled": false,
          "workbench.tree.renderIndentGuides": "none",
          "explorer.compactFolders": false
        }
      }
    },
    "backend": {
      "config": {
        "configDirName": ".arduinoIDE",
        "releaseNotes": "https://github.com/sanir321/arduino-ai/releases",
        "singleInstance": true
      }
    }
  },
  "author": "Arduino SA",
  "description": "Arduino AI IDE - AI-enhanced Arduino development environment"
}
